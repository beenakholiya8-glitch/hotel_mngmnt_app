<mvc:View controllerName="com.hma.hotelmngmnt.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <Table sticky="HeaderToolbar,ColumnHeaders" id="idProductsTable" selectionChange=".selection" width="auto" 
        items="{/Guests}">
        <columns>
            <Column id="_IDGenColumn1">
                <Text id="_IDGenText" text="First Name"/>
            </Column>
            <Column id="_IDGenColumn2">
                <Text id="_IDGenText1" text="Last Name"/>
            </Column>
            <Column id="_IDGenColumn3">
                <Text id="_IDGenText3" text="Mobile No."/>
            </Column>
            <Column id="_IDGenColumn4">
                <Text id="_IDGenText4" text="Email"/>
            </Column>
        </columns>
        <items>
            <ColumnListItem id="_IDGenColumnListItem" type="Navigation" press="onPress">
                <cells>
                    <Text id="_IDGenText5" text="{firstName}"/>
                    <Text id="_IDGenText6" text="{lastName}"/>
                    <Text id="_IDGenText7" text="{phone}"/>
                    <Text id="_IDGenText8" text="{email}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
    <Button id="create" text="Create Guest" press="createGuestList"></Button>
    </Page>
</mvc:View>